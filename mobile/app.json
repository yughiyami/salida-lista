{
  "expo": {
    "name": "Salida Lista",
    "slug": "salida-lista",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/brand/salida-lista-mark.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.salidalista.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#163F35",
        "foregroundImage": "./assets/brand/salida-lista-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.salidalista.mobile",
      "versionCode": 9,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withCmakeObjectPathLimit",
      "expo-sqlite",
      "expo-router",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Salida Lista comparte tu ubicación con tu círculo aunque la app esté cerrada, para avisar cuando llegas o sales de un lugar. Puedes pausarlo o apagarlo en Ajustes.",
          "locationWhenInUsePermission": "Salida Lista usa tu ubicación para mostrarte en el mapa y compartirla con tu círculo mientras usas la app.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#163F35",
          "defaultChannel": "circle"
        }
      ],
      "expo-font"
    ],
    "scheme": "salidalista",
    "platforms": [
      "ios",
      "android"
    ]
  }
}
