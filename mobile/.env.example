# Copia este archivo a mobile/.env y completa los valores de tu proyecto en Supabase.
# Nunca incluyas mobile/.env en Git ni coloques claves secretas de servidor (service_role) en EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.reemplazar-con-anon-o-publishable-key

# Reservada para integraciones adicionales de API cuando exista un backend autorizado.
